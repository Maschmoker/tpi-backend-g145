# =============================================================================
# Plantilla de variables de entorno — Guardería de Mascotas
# Copiar como .env (git lo ignora) y ajustar valores.
#   Copy-Item .env.example .env
#
# Los valores incluidos son SOLO para desarrollo local. No usar en producción.
# Si una contraseña contiene "$", escaparlo como "$$" (interpolación de Compose).
# =============================================================================

# --------------------------------- PostgreSQL --------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_change_me

# --------------------- Bases de datos y usuarios por servicio ----------------
CLIENTES_DB=clientes_db
CLIENTES_DB_USER=clientes_user
CLIENTES_DB_PASSWORD=clientes_dev_change_me

ESTADIAS_DB=estadias_db
ESTADIAS_DB_USER=estadias_user
ESTADIAS_DB_PASSWORD=estadias_dev_change_me

LOGISTICA_DB=logistica_db
LOGISTICA_DB_USER=logistica_user
LOGISTICA_DB_PASSWORD=logistica_dev_change_me

KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_dev_change_me

# ---------------------------------- Keycloak ---------------------------------
KEYCLOAK_PORT=8088
KEYCLOAK_URL=http://localhost:8088
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_change_me

# Debe coincidir con "realm" y los "clientId" definidos en
# docker/keycloak/realm-export.json (no son placeholders del JSON).
KEYCLOAK_REALM=guarderia
KEYCLOAK_PUBLIC_CLIENT_ID=guarderia-swagger
KEYCLOAK_SERVICE_CLIENT_ID=guarderia-service

# Consumidas por realm-export.json durante el import (placeholders ${VAR})
KEYCLOAK_SERVICE_CLIENT_SECRET=service_dev_change_me
KEYCLOAK_TEST_USER_PASSWORD=Test1234!

# URLs derivadas para la configuración de los microservicios
KEYCLOAK_ISSUER_URI=http://localhost:8088/realms/guarderia
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/guarderia/protocol/openid-connect/certs

# --------------------------- Servicios / Spring ------------------------------
# Valores por defecto para ejecución local. docker-compose.yml sobrescribe
# SPRING_PROFILES_ACTIVE=docker, DB_HOST=postgres y las URLs internas.
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=5432
CLIENTES_SERVICE_URL=http://clientes-service:8081
ESTADIAS_SERVICE_URL=http://estadias-service:8082
LOGISTICA_SERVICE_URL=http://logistica-service:8083

# ------------------------------ Google Maps ----------------------------------
# Nunca versionar una clave real. Vacío = contingencia Haversine (ruta estimada).
GOOGLE_MAPS_API_KEY=
