<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        La librería comparte el parent con los microservicios para alinear versiones
        (Spring Framework 7.0.11 / Spring Security 7.1.3 sobre Boot 4.1.3).
        No se declara spring-boot-maven-plugin: este módulo NO es ejecutable.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.3</version>
        <relativePath/>
    </parent>

    <groupId>com.guarderia</groupId>
    <artifactId>guarderia-commons</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>guarderia-commons</name>
    <description>Componentes técnicos transversales de la Guardería de Mascotas</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- API web: @ExceptionHandler, ResponseEntity, HttpStatus, OncePerRequestFilter -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!--
            Necesario para BindingResult y ParameterValidationResult usados por el
            manejador base de errores: spring-web 7 no lo trae transitivamente.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- JwtAuthenticationConverter / ReactiveJwtAuthenticationConverter -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Jwt vive en oauth2-jose; el POM de resource-server 7.1.3 no lo arrastra -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!-- ConstraintViolationException y anotaciones Bean Validation -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Filtro servlet: la implementación la aporta el contenedor de cada servicio -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Solo API de logging/MDC; la implementación (Log4j2) la aporta cada servicio -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Pruebas unitarias puras, sin spring-boot-starter-test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Proveedor SLF4J real para las pruebas de correlación: slf4j-simple 2.0.20
            devuelve NOPMDCAdapter, mientras que Log4j2 (implementación usada por los
            servicios) sí expone un MDC funcional.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
