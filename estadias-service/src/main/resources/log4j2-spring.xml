<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback está excluido del classpath (ver pom.xml): la única implementación es Log4j2.
    %X{correlationId} toma el valor que CorrelationIdFilter publica en el MDC;
    queda vacío cuando la solicitud no pasó por el filtro (p. ej. durante el arranque).
-->
<Configuration status="WARN">
    <Properties>
        <Property name="PATRON">%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [estadias-service] [%t] %logger{40} [correlationId=%X{correlationId}] - %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="CONSOLA" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATRON}"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="com.guarderia" level="DEBUG" additivity="false">
            <AppenderRef ref="CONSOLA"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="CONSOLA"/>
        </Root>
    </Loggers>
</Configuration>